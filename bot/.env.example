# On the server this file is /opt/lionscraft-bot/.env. Never commit real values.

# Claude (from console.anthropic.com)
ANTHROPIC_API_KEY=

# Telegram: token from @BotFather
TELEGRAM_BOT_TOKEN=
# Team group that gets lead alerts. Add the bot to the group, send /chatid, paste the number here.
TEAM_TELEGRAM_CHAT_ID=

# WhatsApp (Meta developer app > WhatsApp > API setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret word you make up; enter the same word in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Meta app > Settings > Basic > App secret (checks that messages really come from Meta)
WHATSAPP_APP_SECRET=

# Optional
DAILY_MESSAGE_LIMIT=40
