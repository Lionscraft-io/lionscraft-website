# On the server this file is /opt/lionscraft-website/.env. Never commit real values.

# Nous Research API key, the same one the OpenClaw bots use
NOUS_API_KEY=
# Which model Hermes uses (any model the Nous API offers, like deepseek/deepseek-v4.1-flash)
MODEL=anthropic/claude-opus-5.5

# Telegram: make a NEW bot with @BotFather, just for this agent
TELEGRAM_BOT_TOKEN=
# Who may use the agent: Telegram user IDs, comma separated.
# Message the bot once and it tells you your ID.
TELEGRAM_ALLOWED_USERS=
# Groups where the team can use it (mention the bot or reply to it), comma separated
TELEGRAM_ALLOWED_GROUPS=

# Filled in by setup.sh: this server's web address and the secret parts of the MCP and preview links
PUBLIC_URL=
MCP_KEY=
PREVIEW_KEY=

# Optional
GITHUB_REPO=git@github.com:Lionscraft-io/lionscraft-website.git
GITHUB_BRANCH=main
# The branch Replit deploys; it only moves when you say release
LIVE_BRANCH=live
